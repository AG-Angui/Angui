VITE_API_BASE_URL=/api

# 高德地图配置
# 获取方式：访问 https://console.amap.com/ 创建应用并获取 Web端(JS API) 的 Key
VITE_AMAP_JS_API_KEY=

# Optional local-development-only direct JSAPI security code. Production must
# leave this empty and use the same-origin /_AMapService proxy.
VITE_AMAP_JS_API_SERVICE_HOST=/_AMapService
VITE_AMAP_JS_API_SECURITY_CODE=
