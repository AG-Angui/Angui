ANGUI_HOST=127.0.0.1
ANGUI_PORT=8080
ANGUI_FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=sqlite://data/angui.db?mode=rwc
ANGUI_SESSION_TTL_HOURS=8
# Sensitive collaboration-location storage is disabled unless operations set a
# bounded retention window (1-8760 hours). This value must be approved by
# operations/compliance; no production default is provided.
# ANGUI_COLLABORATION_LOCATION_RETENTION_HOURS=
# Optional SMTP Email delivery. All values are server-only; never commit real credentials.
# When unconfigured, access-request and password-setup messages are recorded as not configured.
# ANGUI_EMAIL_SMTP_HOST=
# ANGUI_EMAIL_SMTP_PORT=587
# ANGUI_EMAIL_SMTP_USERNAME=
# ANGUI_EMAIL_SMTP_PASSWORD=
# ANGUI_EMAIL_SMTP_FROM_ADDRESS=
# ANGUI_EMAIL_SMTP_FROM_NAME=安归
# Absolute safety cap for a single intake answer. Per-question business limits live in the database.
ANGUI_INTAKE_ANSWER_HARD_MAX=2000
# Optional server-only AMap Web Service key. Never expose this key to browsers, logs, or commits.
# AMAP_WEBSERVICE_KEY=
# Server-only signing secret for the five-minute selected-POI route capability.
# Set the same value on every production instance; never expose it to browsers, logs, or commits.
# ANGUI_POI_SELECTION_TOKEN_SECRET=
AMAP_WEBSERVICE_BASE_URL=https://restapi.amap.com
AMAP_TIMEOUT_MS=2500
# Empty by default: the gateway returns the deterministic rule-based path.
# Set this to a JSON array of provider policies. endpoint_env and credential_env
# are environment-variable names, not URLs or secrets. See docs/AI_GATEWAY.md.
# ANGUI_AI_PROVIDERS_JSON=[]
# ANGUI_ASR_URL=http://localhost:8000/transcribe
# ANGUI_ASR_KEY=set-a-private-ASR-token
# ANGUI_LIVEKIT_URL=wss://livekit.example.org
# ANGUI_LIVEKIT_ADMIN_URL=http://127.0.0.1:7880
# ANGUI_LIVEKIT_API_KEY=angui-production
# ANGUI_LIVEKIT_API_SECRET=at-least-32-random-characters
# ANGUI_TURN_URL=turn:turn.example.org:3478?transport=udp
# ANGUI_TURN_SECRET=long-random-coturn-shared-secret
# Set only while running `npm run auth:bootstrap-demo`; use 12-256 characters.
ANGUI_DEMO_PASSWORD=replace-with-a-local-demo-password
# Private intercom/voice-report objects. Keep this directory on encrypted persistent storage.
ANGUI_AUDIO_STORAGE_DIRECTORY=data/audio
RUST_LOG=info
