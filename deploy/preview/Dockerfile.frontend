# syntax=docker/dockerfile:1.7

FROM nginx:1.29-alpine
COPY deploy/preview/nginx.conf /etc/nginx/default.conf.template
COPY .preview/frontend/ /usr/share/nginx/html/
EXPOSE 80
CMD ["/bin/sh", "-c", "envsubst '$AMAP_JSAPI_SECURITY_CODE' < /etc/nginx/default.conf.template > /etc/nginx/conf.d/default.conf && exec nginx -g 'daemon off;'"]
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=5 \
  CMD wget -q -O /dev/null http://127.0.0.1/healthz || exit 1
